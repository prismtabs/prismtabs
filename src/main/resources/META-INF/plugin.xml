<idea-plugin>
    <id>io.chromatabs</id>
    <name>Chromatabs</name>
    <vendor>Andrzej</vendor>

    <description><![CDATA[
        Chrome-style colour groups for IntelliJ editor tabs.
        <br/><br/>
        <b>Phase 1 build.</b> Assignments persist across restarts. The colour swatch popup
        lands in Phase 2 — for now, two hard-coded colours on the tab right-click menu.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Confirmed EP: com.intellij.editorTabColorProvider

             order="first" is REQUIRED, not cosmetic. EditorTabPresentationUtil.getEditorTabBackgroundColor
             iterates this EP in registration order and returns the FIRST non-null colour. The platform's
             own EditorTabColorProviderImpl delegates to FileColorManager.getFileColor(), and IntelliJ
             ships default File Colors scopes (notably "Tests" and "Non-Project Files"). Without
             order="first", every file matching one of those scopes gets the platform's colour and this
             provider is never consulted at all.

             This encodes a policy decision: an explicit Chromatabs group assignment beats a File Colors
             scope match. That matches Chrome, where the colour the user pinned to a tab is the colour
             they get. -->
        <editorTabColorProvider implementation="io.chromatabs.provider.TabGroupColorProvider" order="first"/>
    </extensions>

    <actions>
        <!-- PHASE 1 SCAFFOLDING: hard-coded red/blue/clear, replaced by the Chrome-style swatch
             popup in Phase 2. EditorTabPopupMenu is the editor-tab right-click menu; the platform's
             own LangActions.xml registers into this group too. -->
        <group id="Chromatabs.AssignGroup" text="Chromatabs" popup="true">
            <action id="Chromatabs.AssignRed" class="io.chromatabs.action.AssignRedTabGroupAction"
                    text="Assign Red" description="Assign this tab to the (Phase 1 scaffold) Red group"/>
            <action id="Chromatabs.AssignBlue" class="io.chromatabs.action.AssignBlueTabGroupAction"
                    text="Assign Blue" description="Assign this tab to the (Phase 1 scaffold) Blue group"/>
            <action id="Chromatabs.Clear" class="io.chromatabs.action.ClearTabGroupAction"
                    text="Clear Group" description="Remove this tab's group assignment"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
        </group>
    </actions>
</idea-plugin>
