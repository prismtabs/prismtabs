<idea-plugin>
    <id>io.chromatabs</id>
    <name>Chromatabs</name>
    <vendor>Andrzej</vendor>

    <description><![CDATA[
        Chrome-style colour groups for IntelliJ editor tabs.
        <br/><br/>
        <b>Phase 4 build.</b> Right-click a tab for the colour swatch popup: 8 preset colours, add
        to an existing group, or create a new named one. "Manage Groups…" lets you rename, recolour,
        delete, or mark a group active — files opened while a group is active join it automatically.
        The "Tab Groups" tool window lists every group with its colour and member count, and can
        collapse a group (closing its tabs, remembering them) or expand it again. Assignments and
        collapsed state persist across restarts.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Confirmed EP: com.intellij.editorTabColorProvider

             order="first" is REQUIRED, not cosmetic. EditorTabPresentationUtil.getEditorTabBackgroundColor
             iterates this EP in registration order and returns the FIRST non-null colour. The platform's
             own EditorTabColorProviderImpl delegates to FileColorManager.getFileColor(), and IntelliJ
             ships default File Colors scopes (notably "Tests" and "Non-Project Files"). Without
             order="first", every file matching one of those scopes gets the platform's colour and this
             provider is never consulted at all.

             This encodes a policy decision: an explicit Chromatabs group assignment beats a File Colors
             scope match. That matches Chrome, where the colour the user pinned to a tab is the colour
             they get. -->
        <editorTabColorProvider implementation="io.chromatabs.provider.TabGroupColorProvider" order="first"/>

        <!-- Phase 4b: the stable home for everything the tab strip can't show (no in-strip group
             chip — see README §"Constraints that are not going away"). Also where collapse/expand
             ("close and remember", Phase 4a) is driven from. -->
        <toolWindow id="Tab Groups" anchor="right" icon="AllIcons.Toolwindows.ToolWindowPalette"
                    factoryClass="io.chromatabs.ui.TabGroupsToolWindowFactory"/>
    </extensions>

    <!-- Phase 3's "sticky active group" inheritance: dynamic-plugin-safe registration (no
         <component>, no manual MessageBusConnection.subscribe in a startup activity). -->
    <projectListeners>
        <listener class="io.chromatabs.listener.TabGroupFileListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>

        <!-- Phase 5's rename/move remap (the Phase 1 TODO). VFS_CHANGES is an application-level
             topic, but its TO_DIRECT_CHILDREN broadcast direction still reaches a project-level
             subscriber here — confirmed in the platform bytecode, see TabGroupVfsListener's doc.
             Same registration shape the platform's own bundled plugins use for this exact topic
             (e.g. javaFX's FxmlPresenceListener). -->
        <listener class="io.chromatabs.listener.TabGroupVfsListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <!-- EditorTabPopupMenu is the editor-tab right-click menu; the platform's own
             LangActions.xml registers into this group too, hence anchor="first". The action opens
             TabGroupPopup itself (JBPopupFactory), rather than being a plugin.xml <group>, because
             the popup's tree is dynamic (existing groups, current-assignment state). -->
        <action id="Chromatabs.AssignTabGroup" class="io.chromatabs.action.AssignTabGroupAction"
                text="Tab Group…" description="Assign this tab's colour group">
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
